---
import Img from './Img.astro';
import Num from './Num.astro';
import { MONITOR as M } from '../data/site';
/* Réplica animada da tela do app de monitoramento, com os valores reais da usina SW Solar. */
---
<div class="rv" style="--i:2">
  <div class="phone" role="img" aria-label={`Aplicativo de monitoramento SW Solar: ${M.semana} kWh na semana, ${M.mes} kWh no mês, ${M.ano} kWh no ano e ${M.co2} toneladas de CO2 evitadas.`}>
    <div class="scr" aria-hidden="true">
      <div class="top"><Img src="logo/sw-branco" alt="" widths={[200]} sizes="120px" /><i></i></div>
      <div class="ttl"><small>USINA SOLAR</small><b>SW SOLAR</b></div>
      <div class="box">
        <div class="now">
          <svg class="sun" viewBox="0 0 52 52">
            <g class="r" stroke="#ffb020" stroke-width="3" stroke-linecap="round">
              {Array.from({ length: 8 }, (_, i) => <line x1="26" y1="4" x2="26" y2="10" transform={`rotate(${i * 45} 26 26)`} />)}
            </g>
            <circle cx="26" cy="26" r="11" fill="#ffc531" />
          </svg>
          <div><span class="st">AGORA · STATUS</span><div class="ok"><i></i>Ok</div></div>
        </div>
        <div class="g">
          <div><small>ESSA SEMANA</small><b><Num value={M.semana} /><em>kWh</em></b></div>
          <div><small>ESSE MÊS</small><b><Num value={M.mes} /><em>kWh</em></b></div>
          <div><small>ESSE ANO</small><b><Num value={M.ano} dur={2200} /><em>kWh</em></b></div>
          <div><small>TOTAL</small><b><Num value={M.ano} dur={2200} /><em>kWh</em></b></div>
        </div>
      </div>
      <div class="box">
        <div class="co2"><small class="st">REDUÇÃO DE EMISSÕES</small><b><Num value={M.co2} /><em style="font-size:11px;font-style:normal"> t CO₂</em></b></div>
        <div class="prog"><i></i></div>
        <div class="g">
          <div><small>ÁRVORES SALVAS</small><b><Num value={M.arvores} /></b></div>
          <div><small>TRANSP. INDIVIDUAL</small><b><Num value={M.km} /><em>km</em></b></div>
        </div>
      </div>
    </div>
  </div>
  <p class="phone-leg">Tela do app de monitoramento SW Solar</p>
</div>
